# The environment variables browser-verified reads.
#
# Every one of these is OPTIONAL. Mode A — the host agent driving bv — needs
# none of them. Copy this file to .env only if you are setting up a local
# development environment; the CLI reads the environment directly, not a .env
# file.

# --- The secrets vault passphrase -------------------------------------------
# Required only if you use `bv vault`. The vault is encrypted with
# AES-256-GCM and a key derived from this value with scrypt. If you lose
# it, the vault cannot be decrypted.
#
# Do NOT put a real passphrase in a committed .env file.
BV_VAULT_PASSPHRASE=

# --- The model provider key --------------------------------------------------
# Required only for Mode B, where a model decides what to do next inside the
# agent loop. Mode A is unaffected by its absence, and `bv doctor` reports
# exactly which capabilities are unavailable without it.
ANTHROPIC_API_KEY=

# --- The contact URL in the user agent ---------------------------------------
# The honest user agent carries a contact URL so a site owner can reach you.
# Set it to a real, working address. `bv doctor` and the default policy
# expect an @url: marker.
BV_CONTACT_URL=

# --- Playwright --------------------------------------------------------------
# The browser build to use. The default is chromium, which is the only
# browser this project tests.
BROWSER=chromium

# --- Debugging ---------------------------------------------------------------
# Set to 1 for verbose daemon logging.
BV_DEBUG=
