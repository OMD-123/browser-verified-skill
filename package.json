{
  "name": "browser-verified",
  "version": "0.1.0",
  "description": "Browser-verified: safety-first browser automation toolkit with evidence, compilation to Playwright, and self-repair.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "bv": "./scripts/bv.mjs"
  },
  "files": [
    "scripts/bv.mjs",
    "policies/",
    "references/",
    "SKILL.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:e2e": "vitest run test/e2e",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "build": "tsup",
    "cli": "tsx src/cli/main.ts",
    "fixtures": "tsx fixtures/server.ts",
    "verify:all": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@typescript-eslint/project-service": "^8.72.1",
    "@typescript-eslint/scope-manager": "^8.72.1",
    "@typescript-eslint/tsconfig-utils": "^8.72.1",
    "@typescript-eslint/type-utils": "^8.72.1",
    "@typescript-eslint/types": "^8.72.1",
    "@typescript-eslint/typescript-estree": "^8.72.1",
    "@typescript-eslint/utils": "^8.72.1",
    "@typescript-eslint/visitor-keys": "^8.72.1",
    "better-sqlite3": "13.0.3",
    "commander": "15.0.0",
    "p-limit": "7.3.3",
    "pino": "10.4.0",
    "pixelmatch": "8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "7.0.0",
    "robots-parser": "3.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
